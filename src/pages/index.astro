---
import App from '../App';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../style.css';
const title = 'Cozy Gray — Light & Dark Editor and Terminal Themes';
const description = 'A warm gray color theme for editors and terminals. Preview light and dark palettes, explore brighter syntax colors, and download files for VS Code, Ghostty, Neovim, and more.';
const canonical = new URL('/', Astro.site).href;
const image = new URL('/og/cozy-gray.jpg', Astro.site).href;
const imageAlt = 'Cozy Gray: A softer shade of focus. Light and dark editor windows against warm gray brushstrokes.';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': 'https://marsolab.com/#organization', name: 'Marsolab', url: 'https://marsolab.com' },
    { '@type': 'WebSite', '@id': `${canonical}#website`, url: canonical, name: 'Cozy Gray', description, inLanguage: 'en', publisher: { '@id': 'https://marsolab.com/#organization' }, sameAs: 'https://github.com/marsolab/cozygray' },
    { '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: title, description, inLanguage: 'en', isPartOf: { '@id': `${canonical}#website` }, primaryImageOfPage: { '@type': 'ImageObject', url: image, width: 1200, height: 630 } },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#eeedeb" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Cozy Gray" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:secure_url" content={image} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" type="image/png" href="/assets/cozy-gray-logo.png" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
  </head>
  <body><App client:load /></body>
</html>

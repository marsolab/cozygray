---
import App from '../App';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../style.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#eeedeb" />
    <meta name="description" content="Cozy Gray is a warm gray color theme for your editor and terminal. Explore light and dark palettes and find a quieter workspace." />
    <link rel="icon" type="image/png" href="/assets/cozy-gray-logo.png" />
    <title>Cozy Gray — A softer shade of focus</title>
  </head>
  <body><App client:load /></body>
</html>

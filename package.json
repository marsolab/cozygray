{
  "name": "cozy-gray",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 5173",
    "build": "bun run check && astro build",
    "preview": "astro preview --host 0.0.0.0 --port 5173",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "oxlint --type-aware --type-check",
    "check": "bun run lint && bun run format:check && bun run typecheck && astro check",
    "build:zed": "bun scripts/build-zed-extension.mjs",
    "validate:zed": "bun scripts/build-zed-extension.mjs --check",
    "validate:themes": "bun scripts/validate-theme.mjs && bun run validate:zed",
    "validate:site": "bun scripts/validate-site.mjs",
    "deploy": "bun run build && bun run validate:themes && bun run validate:site && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "gsap": "^3.13.0",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/compiler-rs": "^0.5.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "~5.8.3",
    "wrangler": "4.149.0"
  },
  "packageManager": "bun@1.4.4"
}
